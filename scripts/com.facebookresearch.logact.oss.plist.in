<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.facebookresearch.logact.oss</string>
  <key>ProgramArguments</key>
  <array>
    <string>LOGACT_SERVER_PATH</string>
    <string>--socket</string>
    <string>LOGACT_SOCKET_PATH</string>
    <string>--sqlite-path</string>
    <string>LOGACT_SQLITE_PATH</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Decimal 63 is octal 077, restricting new files to the current user. -->
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>LOGACT_LOG_PATH</string>
  <key>StandardErrorPath</key>
  <string>LOGACT_LOG_PATH</string>
</dict>
</plist>
